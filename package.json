{
  "name": "odc-front",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "test:changed": "vitest run --changed",
    "test:logic": "vitest run tests/modules tests/scripts",
    "test:auth": "vitest run tests/stores/authStore tests/views/LoginView tests/views/RegisterView tests/views/ProfilView tests/views/AddCharacterView tests/views/VerifyEmailView tests/router",
    "test:cookies": "vitest run tests/stores/cookieStore tests/components/CookiesBanner tests/components/CookiesModal",
    "test:eco": "vitest run tests/modules/mineParser tests/views/EconomyMines",
    "test:security": "vitest run tests/views/SecurityGuet",
    "test:common": "vitest run tests/components/NavBar tests/components/NavMenu tests/components/HelpModal tests/views/HomeView",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@ipaat/vue3-tailwind3-cookie-comply": "^1.1.2",
    "axios": "^1.6.7",
    "notivue": "^2.4.5",
    "oh-vue-icons": "^1.0.0-rc3",
    "pinia": "^2.1.7",
    "unimport": "^3.7.1",
    "vue": "^3.4.15",
    "vue-i18n": "^9.9.1",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^2.0.0",
    "@pinia/testing": "^0.1.7",
    "@rushstack/eslint-patch": "^1.3.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/test-utils": "^2.4.3",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "postcss-nesting": "^12.0.2",
    "prettier": "^3.0.3",
    "tailwindcss": "^3.4.1",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
